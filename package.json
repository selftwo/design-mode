{
  "name": "local-design-review-canvas",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"node scripts/testing/serve-live-review-fixture.mjs\"",
    "dev:fixture": "node scripts/testing/serve-live-review-fixture.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "measure": "node scripts/testing/measure-canvas-bundles.mjs",
    "check:repo": "node scripts/check-repository-shape.mjs",
    "verify": "npm run check:repo && npm run test && npm run build && npm run measure && npm run test:e2e"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@xyflow/react": "12.11.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/pngjs": "6.0.5",
    "@types/node": "22.10.2",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "9.1.2",
    "typescript": "5.7.2",
    "pngjs": "7.0.0",
    "vite": "5.4.21",
    "vitest": "3.2.6"
  }
}
